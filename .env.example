EXPO_PUBLIC_APP_ENV=development
# Origin + base path of the Muenot ERP mobile API.
# Production: https://erp.muenot.co.in/api/mobile/v1
EXPO_PUBLIC_API_BASE_URL=https://erp.muenot.co.in/api/mobile/v1
# Per-request timeout in milliseconds. Optional; defaults to 20000.
EXPO_PUBLIC_API_TIMEOUT_MS=20000
# Set to the actual published Muenot legal pages before release.
# EXPO_PUBLIC_TERMS_URL=https://...
# EXPO_PUBLIC_PRIVACY_URL=https://...
# Path to the private Firebase Android config file used by local/EAS native builds.
# On EAS, configure GOOGLE_SERVICES_JSON as a file environment variable.
# GOOGLE_SERVICES_JSON=./google-services.json
